{
  "name": "m68k-parser",
  "version": "1.10.0",
  "description": "Motorola 68000 assembly parser",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-parser.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "m68k-parser": "cli.js"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "m68k",
    "68000",
    "motorola",
    "assembly",
    "parser",
    "assembler",
    "ast"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:bundle && npm run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:bundle": "node build.js",
    "clean": "rm -rf dist",
    "test": "jest",
    "preview": "npm run build:bundle && node preview.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/test/**/*"
    ]
  }
}
