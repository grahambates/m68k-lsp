{
  "name": "m68k-lint",
  "version": "1.0.0",
  "description": "Extensible static analysis and linting for Motorola 68k assembly",
  "keywords": [
    "m68k",
    "68000",
    "68k",
    "motorola",
    "assembly",
    "asm",
    "lint",
    "linter",
    "static-analysis",
    "amiga",
    "atari-st",
    "optimization"
  ],
  "homepage": "https://github.com/grahambates/m68k-lint#readme",
  "bugs": {
    "url": "https://github.com/grahambates/m68k-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-lint.git"
  },
  "author": "Graham Bates",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "m68k-lint.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node ./dist/cli/main.js",
    "audit:impact": "node ./dist/cli/main.js --audit-rule-impact",
    "verify:semantics": "npm run build && node --experimental-wasm-modules ./scripts/verify-semantics.mjs",
    "docs:rules": "npm run build && node ./scripts/generate-rules-doc.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit:impact"
  },
  "dependencies": {
    "68kcounter": "^4.0.0",
    "m68k-parser": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@specy/s68k": "^1.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/src/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/test/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 75,
        "branches": 68,
        "functions": 65,
        "lines": 80
      }
    }
  },
  "bin": {
    "m68k-lint": "./dist/cli/main.js"
  }
}
