{
  "name": "m68ktools",
  "version": "0.11.3",
  "private": true,
  "description": "Motorola 68000 assembly language server and VS Code extension",
  "license": "MIT",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-lsp.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --minify",
    "build:dev": "node scripts/build.mjs --sourcemap",
    "watch": "node scripts/build.mjs --sourcemap --watch",
    "clean": "rm -rf packages/*/out packages/*/.tsbuild apps/m68k-lsp/wasm",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "typecheck": "tsc -b packages/m68k-lsp-server apps/m68k-lsp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build-docs": "scripts/conv-directives && scripts/conv-instructions",
    "package": "pnpm --filter m68k-lsp package",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "build:formatter": "pnpm --filter m68k-formatter build",
    "pretest": "pnpm run build:formatter"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.38.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
