{
  "name": "m68k-parser",
  "version": "1.10.0",
  "description": "Motorola 68000 assembly parser",
  "author": "Graham Bates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-tools.git",
    "directory": "packages/m68k-parser"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "m68k-parser": "cli.js"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "cli.js"
  ],
  "keywords": [
    "m68k",
    "68000",
    "motorola",
    "assembly",
    "parser",
    "assembler",
    "ast"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "preview": "pnpm run build && node preview.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.0",
    "esbuild": "^0.25.11",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "tsdown": "0.23.0"
  },
  "engines": {
    "node": ">=22.15.1"
  }
}
