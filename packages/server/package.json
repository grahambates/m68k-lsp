{
  "name": "m68k-lsp-server",
  "description": "Motorola 68000 assembly language server in node.",
  "version": "0.11.3",
  "author": "Graham Bates",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "m68k-lsp-server": "cli.js"
  },
  "main": "out/server.js",
  "files": [
    "cli.js",
    "out",
    "wasm",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahambates/m68k-lsp.git",
    "directory": "packages/server"
  },
  "dependencies": {
    "minimatch": "^10.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8",
    "web-tree-sitter": "^0.20.8",
    "which": "^4.0.0"
  },
  "scripts": {
    "build-wasm": "npx tree-sitter build-wasm --docker node_modules/tree-sitter-m68k; mv -f tree-sitter-m68k.wasm wasm/"
  },
  "devDependencies": {
    "@types/which": "^3.0.4",
    "tree-sitter-m68k": "^0.3.2"
  }
}
